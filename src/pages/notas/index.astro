---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Notas · Leo Thaylor" description="Registros de trabalho de Leo Thaylor sobre projetos, sistemas, testes, decisões e jiu-jitsu.">
  <section class="page-hero section-pad page-hero--compact reveal">
    <span class="eyebrow">NOTAS</span>
    <h1>Notas de trabalho.</h1>
    <p>Registro decisões, mudanças de direção, bugs, testes e ideias que quero conseguir consultar depois. Alguns textos explicam projetos; outros preservam de onde uma decisão veio.</p>
  </section>
  <section class="section-pad section-pad--topless">
    <div class="notes-grid notes-grid--archive">
      {notes.map((note) => <NoteCard note={note} />)}
    </div>
  </section>
</BaseLayout>
