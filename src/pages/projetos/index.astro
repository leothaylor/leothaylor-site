---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projetos · Leo Thaylor" description="Sites, produtos, automações e sistemas construídos ou dirigidos por Leo Thaylor.">
  <section class="page-hero section-pad page-hero--compact reveal">
    <span class="eyebrow">PROJETOS</span>
    <h1>Coisas que eu construí, dirigi ou coloquei para funcionar.</h1>
    <p>Cada case mostra o escopo, meu papel, o estado atual e alguma evidência concreta. Quando existe uma versão pública, você pode abrir o projeto ou consultar o repositório.</p>
  </section>

  <section class="section-pad section-pad--topless">
    <div class="taxonomy-line reveal">
      <span>PUBLICADO</span><span>OPERADO</span><span>ENTREGUE</span><span>SISTEMA INTERNO</span><span>LABORATÓRIO</span>
    </div>
    <div class="project-grid project-grid--archive">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
